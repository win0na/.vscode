// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+k k",
        "command": "opencode.openTerminal"
    },
    {
        "key": "ctrl+escape",
        "command": "-opencode.openTerminal"
    },
    {
        "key": "ctrl+k shift+k",
        "command": "opencode.openNewTerminal"
    },
    {
        "key": "ctrl+shift+escape",
        "command": "-opencode.openNewTerminal"
    },
    {
        "key": "ctrl+p",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u0010"
        },
        "when": "terminalFocus && isOpencode"
    },
    {
        "key": "ctrl+n",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u000e"
        },
        "when": "terminalFocus && isOpencode"
    },
    {
        "key": "ctrl+alt+p",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u0010"
        },
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+alt+n",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u000e"
        },
        "when": "terminalFocus"
    }
]
